[sub_resource type="GDScript" id="GDScript_nfjy2"]
resource_name = "radom"
script/source = "extends Node

signal coins_changed(new_total: int)

var coins: int = 0

func add_coin(amount: int = 1) -> void:
    coins += amount
    coins_changed.emit(coins)

func reset() -> void:
    coins = 0
    coins_changed.emit(coins)
"


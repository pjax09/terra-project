[gd_scene format=3 uid="uid://b8a1nloakyoq4"]

[sub_resource type="GDScript" id="GDScript_yf5fn"]
resource_name = "killzone"
script/source = "extends Area2D

@onready var timer: Timer = $Timer
@onready var player = $\"../player\"

func _on_body_entered(body: Node2D) -> void:
	print (\"you died\")
	player.velocity = Vector2.ZERO
	
	timer.start()

func _on_timer_timeout() -> void:
	get_tree().reload_current_scene()
"

[node name="kill zone" type="Area2D" unique_id=2021737760]
collision_mask = 2
script = SubResource("GDScript_yf5fn")

[node name="Timer" type="Timer" parent="." unique_id=1925325308]
one_shot = true

[connection signal="body_entered" from="." to="." method="_on_body_entered"]
[connection signal="timeout" from="Timer" to="." method="_on_timer_timeout"]
